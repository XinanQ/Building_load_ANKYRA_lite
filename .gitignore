# Python caches and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.tox/
.cache/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Model weights. Every weights file is ignored except the released carrier checkpoints of 0.1.0:
# checkpoints/<population>/seed<s>.pt (9 populations x seeds 0-2, one rule each below) and checkpoints/MANIFEST.json,
# written by tools/export_checkpoints.py --out checkpoints. Train your own carriers into runs/ (ignored below), not
# checkpoints/: any other weights file under checkpoints/ stays ignored.
*.pt
*.pth
*.ckpt
*.safetensors
!checkpoints/bdg2/seed[0-2].pt
!checkpoints/goiener_confirm/seed[0-2].pt
!checkpoints/households/seed[0-2].pt
!checkpoints/cambridge/seed[0-2].pt
!checkpoints/heew/seed[0-2].pt
!checkpoints/eweld/seed[0-2].pt
!checkpoints/oslo/seed[0-2].pt
!checkpoints/drammen/seed[0-2].pt
!checkpoints/cineldi/seed[0-2].pt
!checkpoints/MANIFEST.json

# Raw data, data stores, saved forecasts and arrays are never committed
data/
stores/
*.npz
*.npy
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.zip

# Scratch and temporary files (runs/: your own training runs, e.g. the code example of docs/METHOD.md)
runs/
scratch/
tmp/
*.tmp
*.part
*.bak
*.swp
*~

# results/ (scored tables, CSV / JSON / Markdown / log) and figures/ (PDF / PNG and make_figures.py) are tracked.
